<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activites.ChooseNumberOfPlayersActivity" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal" >

        <Button
            android:id="@+id/threePlayerButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/lachs"
            android:text="3 \n Zauberlehrlinge"
            android:onClick="onPlayerNumberSelectedClick">
        </Button>

        <Button
            android:id="@+id/fourPlayerButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/purple_200"
            android:text="4 \n Zauberlehrlinge"
            android:onClick="onPlayerNumberSelectedClick">
        </Button>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal" >

        <Button

            android:id="@+id/fivePlayerButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/teal_200"
            android:text="5 \n Zauberlehrlinge"
            android:onClick="onPlayerNumberSelectedClick" >
        </Button>

        <Button
            android:id="@+id/sixPlayerButton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/rosa"
            android:text="6 \n Zauberlehrlinge"
            android:onClick="onPlayerNumberSelectedClick" >
        </Button>
    </LinearLayout>
</LinearLayout>